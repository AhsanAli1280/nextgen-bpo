  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "ts-node --project tsconfig.test.json lib/wht-engine/tests/wht.test.ts",
    "test:rule-engine": "ts-node --project tsconfig.test.json lib/rule-engine/tests/rule-engine.test.ts",
    "test:rule-engine:integration": "ts-node --project tsconfig.test.json lib/rule-engine/tests/integration.test.ts",
    "test:workflow:task-generation": "ts-node --project tsconfig.test.json lib/workflow/tests/task-generation.test.ts",
    "test:workflow:service": "ts-node --project tsconfig.test.json lib/workflow/tests/workflow-service.test.ts",
    "test:workflow:dependency": "ts-node --project tsconfig.test.json lib/workflow/tests/dependency-engine.test.ts",
    "test:workflow:audit": "ts-node --project tsconfig.test.json lib/workflow/tests/audit-trail.test.ts",
    "test:workflow:filing": "ts-node --project tsconfig.test.json lib/workflow/tests/filing-attempts.test.ts",
    "test:notifications": "ts-node --project tsconfig.test.json lib/notifications/tests/notification-adapters.test.ts",
    "test:workflow": "npm run test:workflow:task-generation && npm run test:workflow:service && npm run test:workflow:dependency && npm run test:workflow:audit && npm run test:workflow:filing && npm run test:notifications"
