# Supabase — required for SupabaseDbAdapter and L2 integration tests against real DB
# Get these from: supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...   # NEVER commit this. Server-side only. Never NEXT_PUBLIC_.

# Optional: local Supabase CLI
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=<from npx supabase status>
